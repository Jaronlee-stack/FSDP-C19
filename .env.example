# --- Server ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ask_dojo
DB_USER=postgres
DB_PASSWORD=change_me

# --- Auth (JWT cookie) ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Change-password rate limit (failed attempts per account per window) ---
CHANGE_PW_RATE_MAX=5
CHANGE_PW_RATE_WINDOW_MS=900000

# --- Email Notifications (Brevo) ---
BREVO_API_KEY=change_me_to_brevo_api_key
BREVO_SENDER_EMAIL=noreply@aikidoshinjukai.com.sg
BREVO_SENDER_NAME=Aikido Shinju-Kai

# --- Telegram Bot (announcements & reminders) ---
TELEGRAM_BOT_TOKEN=change_me_to_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=change_me_to_admin_chat_id
