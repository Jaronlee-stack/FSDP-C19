# --- Server ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ask_dojo
DB_USER=postgres
DB_PASSWORD=change_me

# --- Auth (JWT cookie) ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# --- Change-password rate limit (failed attempts per account per window) ---
CHANGE_PW_RATE_MAX=5
CHANGE_PW_RATE_WINDOW_MS=900000
